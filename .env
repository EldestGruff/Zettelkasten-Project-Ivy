# --- Optional Overrides / Defaults for app.core.config.Settings when running locally ---
# These are primarily used if you run the backend directly on the host (not in Docker)
# OR if you want to override defaults set in config.py that are not explicitly set in docker-compose.yml environment.
POSTGRES_USER=zettelkasten_user
POSTGRES_PASSWORD=kV*[_G\+JA=3Iyiu1-(Lz9g);&d6]tHqqf[j3sEwV.kF4E>iAar||$[Sw}1#2xtn
POSTGRES_DB=zettelkasten_db
